# Copy to infra/.env.production and replace every value before deploy.
NODE_ENV=production
VENDURE_DB_SYNCHRONIZE=false
VENDURE_DISABLE_TELEMETRY=true

SITE_ORIGIN=https://example.kz
VENDURE_CORS_ORIGIN=https://example.kz,https://admin.example.kz

ADMIN_KEY=replace_with_32_plus_random_chars
COOKIE_SECRET=replace_with_32_plus_random_chars
APP_SECRET=replace_with_32_plus_random_chars
VENDURE_WEBHOOK_SECRET=replace_with_32_plus_random_chars

SUPERADMIN_USERNAME=admin@example.kz
SUPERADMIN_PASSWORD=replace_with_strong_password

VENDURE_DB_NAME=vendure_db
VENDURE_DB_USER=vendure
VENDURE_DB_PASSWORD=replace_with_strong_db_password

SVET_DB_NAME=svet_ai_db
SVET_DB_USER=svet
SVET_DB_PASSWORD=replace_with_strong_svet_db_password

POSTGRES_USER=postgres
POSTGRES_DB=postgres
POSTGRES_PASSWORD=replace_with_strong_postgres_password

TG_KEY=
TELEGRAM_BOT_TOKEN=
OWNER_ID=
TELEGRAM_MANAGER_CHAT_ID=
OPENAI_API_KEY=
GEMINI_API_KEY=

OPENSEARCH_INITIAL_ADMIN_PASSWORD=replace_with_strong_opensearch_password
